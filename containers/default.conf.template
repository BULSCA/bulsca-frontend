map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    https https;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    resolver ${NGINX_RESOLVERS} valid=10s ipv6=off;
    set $backend http://backend-web:8080;

    location = /health/live {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Resolve at request time so Vue can start while the backend is unavailable.
    location ~ "^/(api(?:/|$)|img/|storage/|resources/view/(?:[0-9]+|[a-fA-F0-9-]{36})$)" {
        proxy_pass $backend;
        proxy_set_header Host ${PUBLIC_API_HOST};
        proxy_set_header X-Forwarded-Host ${PUBLIC_API_HOST};
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_hide_header Set-Cookie;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_next_upstream off;
        proxy_cache off;
        add_header Cache-Control "no-store" always;
    }

    location ~ /\. { return 404; }
    location = /index.html { add_header Cache-Control "no-cache"; }
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location ~* \.(?:js|css|map|png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|pdf)$ {
        try_files $uri =404;
    }
    location / { try_files $uri $uri/ /index.html; }
}
